---
import opencodeRaw from '@lobehub/icons-static-svg/icons/opencode.svg?raw';
import piRaw from '@lobehub/icons-static-svg/icons/pi.svg?raw';
import hermesRaw from '@lobehub/icons-static-svg/icons/hermesagent.svg?raw';
import claudeRaw from '@lobehub/icons-static-svg/icons/claudecode.svg?raw';
import codexRaw from '@lobehub/icons-static-svg/icons/codex.svg?raw';
import cursorRaw from '@lobehub/icons-static-svg/icons/cursor.svg?raw';

interface Props {
	name: 'opencode' | 'pi' | 'oh-my-pi' | 'hermes' | 'claude-code' | 'codex' | 'cursor' | string;
	class?: string;
	size?: string;
}

const { name, class: className = '', size = '1rem' } = Astro.props;
const normalized = name.toLowerCase().trim().replace(/[\s_]+/g, '-');

const ohMyPiRaw = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 90"><rect x="10" y="8" width="100" height="12" rx="2" fill="currentColor"/><rect x="25" y="20" width="12" height="62" rx="2" fill="currentColor"/><rect x="75" y="20" width="12" height="45" rx="2" fill="currentColor"/><rect x="71" y="55" width="20" height="16" rx="3" fill="#f97316"/><rect x="76" y="59" width="3" height="8" rx="1" fill="currentColor"/><rect x="82" y="59" width="3" height="8" rx="1" fill="currentColor"/><circle cx="18" cy="14" r="2" fill="#f97316" opacity=".8"/><circle cx="102" cy="14" r="2" fill="#f97316" opacity=".8"/></svg>`;

const iconMap: Record<string, string> = {
	opencode: opencodeRaw,
	pi: piRaw,
	'oh-my-pi': ohMyPiRaw,
	omp: ohMyPiRaw,
	hermes: hermesRaw,
	'hermes-agent': hermesRaw,
	'claude-code': claudeRaw,
	claude: claudeRaw,
	codex: codexRaw,
	cursor: cursorRaw,
};

const rawSvg = iconMap[normalized] || '';
---

{rawSvg && (
	<span
		class:list={['harness-icon-wrapper', `harness-${normalized}`, className]}
		style={`--harness-icon-size: ${size};`}
		set:html={rawSvg}
	/>
)}

<style>
	.harness-icon-wrapper {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--harness-icon-size, 1rem);
		height: var(--harness-icon-size, 1rem);
		flex-shrink: 0;
		line-height: 1;
	}

	.harness-icon-wrapper :global(svg) {
		width: 100% !important;
		height: 100% !important;
		display: block;
		fill: currentColor;
	}
</style>
